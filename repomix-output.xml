    // Borrowings — إعارة الكتب (ورقي/رقمي)
    Route::prefix('borrowings')->group(function () {
        Route::get('/', [BorrowingController::class, 'index']);                       // عرض سجل وطلبات الإعارة الخاصة بالمستخدم
